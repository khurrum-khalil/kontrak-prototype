{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Kontrak: start server",
      "program": "${workspaceFolder}/server.js",
      "cwd": "${workspaceFolder}",
      "env": { "PORT": "3000" },
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Kontrak: run tests",
      "runtimeArgs": ["--test", "test/compliance.test.js"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Kontrak: reset demo data",
      "program": "${workspaceFolder}/server/seed.js",
      "args": ["--reset"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
